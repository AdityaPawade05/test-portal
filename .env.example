# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/assessment_portal?schema=public"
REDIS_URL="redis://localhost:6379"

# NextAuth Configuration
AUTH_SECRET="your-super-secret-auth-key-change-in-production"
